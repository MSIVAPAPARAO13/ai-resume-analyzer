# ==============================================================================
# RESUMIND ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Use this template for local, staging, and production deployments.
# IMPORTANT: Never commit actual secret values to version control.
# ==============================================================================

# ─── CORE RUNTIME ENVIRONMENT ─────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
FRONTEND_URL=https://resumind.app
CORS_ORIGIN=https://resumind.app

# ─── DATABASE & CACHING ───────────────────────────────────────────────────────
# PostgreSQL Connection URL (SSL required in production: ?sslmode=require)
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>?sslmode=require

# Redis Connection URL (TLS recommended in production: rediss://)
REDIS_URL=rediss://default:<password>@<host>:<port>

# ─── AUTHENTICATION & ENCRYPTION ──────────────────────────────────────────────
# Generate secure 256-bit keys using: openssl rand -base64 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# 32-character encryption key for AES-256-GCM OAuth token encryption
GITHUB_ENCRYPTION_KEY=

# ─── AI PROVIDERS ─────────────────────────────────────────────────────────────
# Google Gemini API Key for Evidence Guard, resume tailoring, and interview analysis
GEMINI_API_KEY=

# Optional: OpenRouter fallback
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ─── EXTERNAL INTEGRATIONS ────────────────────────────────────────────────────
# Adzuna Job Search API
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# GitHub OAuth App Credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://api.resumind.app/api/v1/github/callback

# Google Calendar OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://api.resumind.app/api/v1/calendar/callback

# Resend Email Delivery API
RESEND_API_KEY=

# ─── FRONTEND (Vite / React Router) ───────────────────────────────────────────
# Base URL for API calls from browser client
VITE_API_URL=https://api.resumind.app

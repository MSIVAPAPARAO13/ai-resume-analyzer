{
  "name": "resumind",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@resumind/web",
    "dev:web": "npm run dev --workspace=@resumind/web",
    "dev:api": "npm run dev --workspace=@resumind/api",
    "build": "npm run build --workspace=@resumind/web",
    "build:web": "npm run build --workspace=@resumind/web",
    "build:api": "npm run build --workspace=@resumind/api",
    "start": "npm run start --workspace=@resumind/web",
    "start:api": "npm run start --workspace=@resumind/api",
    "typecheck": "npm run typecheck --workspace=@resumind/web && npm run typecheck --workspace=@resumind/api",
    "typecheck:web": "npm run typecheck --workspace=@resumind/web",
    "typecheck:api": "npm run typecheck --workspace=@resumind/api",
    "lint": "eslint \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "test": "npm run test --workspace=@resumind/api && npm run test --workspace=@resumind/web",
    "test:api": "npm run test --workspace=@resumind/api",
    "test:web": "npm run test --workspace=@resumind/web",
    "test:e2e": "playwright test",
    "db:generate": "npm run prisma:generate --workspace=@resumind/api",
    "db:migrate": "npm run prisma:migrate --workspace=@resumind/api",
    "db:seed": "npm run prisma:seed --workspace=@resumind/api",
    "db:studio": "npm run prisma:studio --workspace=@resumind/api",
    "docker:up": "docker compose up -d postgres redis",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.9",
    "@typescript-eslint/eslint-plugin": "8.24.1",
    "@typescript-eslint/parser": "8.24.1",
    "eslint": "^9.21.0",
    "prettier": "^3.5.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.8"
  }
}
